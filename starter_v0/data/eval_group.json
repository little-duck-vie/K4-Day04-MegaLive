      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-318",
              "check": "network"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_asset_correction",
