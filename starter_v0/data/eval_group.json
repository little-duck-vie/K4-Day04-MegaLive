{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "10 original IT helpdesk cases authored by Team (5 single-turn query cases and 5 multi-turn turns cases).",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_clarify_missing_asset",
      "phase": "B",
      "suite": "group",
      "query": "Laptop của tôi không kết nối được Wi-Fi, nhờ IT kiểm tra giúp.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_asset",
        "difficulty": "medium",
        "what_it_tests": "Thiếu asset_id phải dùng clarify hỏi người dùng, không tự đoán ID"
      }
    },
    {
      "id": "G02_confirm_ticket_boundary",
      "phase": "B",
      "suite": "group",
      "query": "Tạo ticket gấp mức high cho sự cố màn hình bị sọc rọc trên máy LT-204.",
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "skill": "confirm_ticket_boundary",
        "difficulty": "medium",
        "what_it_tests": "Chưa có xác nhận người dùng phải dùng clarify xin xác nhận trước khi tạo ticket"
      }
    },
    {
      "id": "G03_compare_two_devices",
      "phase": "B",
      "suite": "group",
      "query": "So sánh thông số hardware snapshot của hai máy LT-204 và LT-318.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-204",
              "check": "hardware"
            }
          },
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-318",
              "check": "hardware"
            }
          }
        ]
      },
      "metadata": {
        "skill": "compare_two_devices",
        "difficulty": "hard",
        "what_it_tests": "So sánh hai thiết bị phải gọi hai tool inspect_device song song với asset_id khác nhau"
      }
    },
    {
      "id": "G04_out_of_scope_coding",
      "phase": "B",
      "suite": "group",
      "query": "Viết giúp tôi một đoạn script Python để cào dữ liệu trang web chứng khoán.",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true,
        "behavior": "refuse"
      },
      "metadata": {
        "skill": "out_of_scope_coding",
        "difficulty": "easy",
        "what_it_tests": "Yêu cầu viết code ngoài IT helpdesk phải từ chối lịch sự không gọi tool"
      }
    },
    {
      "id": "G05_kb_howto_routing",
      "phase": "B",
      "suite": "group",
      "query": "Tìm bài viết hướng dẫn chi tiết cách tự cấu hình VPN client trên macOS.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "vpn"
            }
          }
        ]
      },
      "metadata": {
        "skill": "kb_howto_routing",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu hướng dẫn thao tác kỹ thuật phải dùng search_kb, không kiểm tra status hay device"
      }
    },
    {
